<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LastFmScrobbler</RootNamespace>
    <AssemblyName>LastFmScrobbler</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.22</Version>
    <!-- Derived from Version so `dotnet publish -p:Version=x.y.z` (build.ps1 -Version)
         also moves the assembly/file version the updater compares against. -->
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Last.fm Scrobbler</Product>
    <Company>Dagkan Bayramoglu</Company>
    <Copyright>Copyright © 2025–2026 Dagkan Bayramoglu</Copyright>
    <Description>Automatic Last.fm scrobbler for Apple Music on Windows</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -p:Beta=true → side-by-side beta build (see Core/AppChannel.cs) -->
  <PropertyGroup Condition="'$(Beta)' == 'true'">
    <DefineConstants>$(DefineConstants);BETA</DefineConstants>
    <Product>Last.fm Scrobbler Beta</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="assets\branding\mark-192.png">
      <LogicalName>mark.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\branding\github-mark-white.png">
      <LogicalName>github-mark.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.9" />
  </ItemGroup>

  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
  </ItemGroup>

</Project>
